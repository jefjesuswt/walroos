# walroos base image: workspaces whose repo has no devcontainer.json run on this.
# The agent builds it locally on first use and tags it with a hash of this file,
# so editing it rebuilds it on the next workspace.
FROM docker.io/library/debian:13-slim

# git + ssh for repos, curl/xz/unzip for mise installs, openssh-sftp-server for the
# SSH gateway's sftp subsystem (scp, VS Code Remote-SSH), sudo so dev can apt install,
# libicu so runtimes that need ICU (.NET crashes on start without it) work out of the box.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      bash bash-completion ca-certificates curl git less libicu76 nano \
      openssh-client openssh-sftp-server procps sudo unzip xz-utils \
 && rm -rf /var/lib/apt/lists/*

# mise (runtimes: node, bun, go, python…), pinned and checksummed.
ARG MISE_VERSION=v2026.11.9
ARG TARGETARCH
RUN case "${TARGETARCH:-amd64}" in \
      amd64) arch=x64;   sum=f13f3e5ec88807e0161669b3aa07a91d84478cdf1e95b5b92b63f85a25d42395 ;; \
      arm64) arch=arm64; sum=b8dd05af6447cee933928664982a8cb2fa646e6951cfc8539db23ce2554a7b04 ;; \
      *) echo "unsupported arch ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o /usr/local/bin/mise "https://github.com/jdx/mise/releases/download/${MISE_VERSION}/mise-${MISE_VERSION}-linux-${arch}" \
 && echo "${sum}  /usr/local/bin/mise" | sha256sum -c - \
 && chmod 0755 /usr/local/bin/mise

# The workspace user. The agent maps the host user onto it (--userns=keep-id).
# /etc/profile resets PATH in login shells (an interactive SSH session is one), so the mise
# shims are added back there too; ENV below covers non-login sessions (ssh host cmd, exec).
RUN useradd --create-home --uid 1000 --shell /bin/bash dev \
 && echo 'dev ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/dev && chmod 0440 /etc/sudoers.d/dev \
 && echo 'eval "$(mise activate bash)"' >> /etc/bash.bashrc \
 && echo 'export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"' > /etc/profile.d/mise.sh

# Runtimes live in $HOME (a volume), so they survive rebuilds. Shims make them work in
# non-interactive sessions too (ssh host cmd, VS Code), where .bashrc isn't read.
ENV LANG=C.UTF-8 \
    PATH=/home/dev/.local/share/mise/shims:/home/dev/.local/bin:$PATH

LABEL devcontainer.metadata='[{"remoteUser":"dev"}]'
USER dev
WORKDIR /home/dev
